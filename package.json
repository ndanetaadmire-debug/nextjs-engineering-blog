{
  "name": "nextjs-engineering-blog",
  "version": "2.0.0",
  "private": true,
  "description": "A statically generated engineering blog on the Next.js App Router: validated Markdown content, sanitized rendering, tags, RSS, sitemap and structured data.",
  "license": "MIT",
  "author": "Admire T. Ndaneta",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:content": "tsx scripts/check-content.ts"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
